# Gemini API key: keep this server-side. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash

# Private admin access: choose a long, unique password and a separate random secret.
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Optional public profile details. Use public-facing contact channels only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
